<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SEO Linker report</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #172033;
        --muted: #667085;
        --line: #e4e7ec;
        --surface: #ffffff;
        --page: #f6f7f9;
        --accent: #3157d5;
        --accent-soft: #eef2ff;
        --warning: #b54708;
        --warning-soft: #fffaeb;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--page);
        color: var(--ink);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
        line-height: 1.55;
      }
      main { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 56px 0 80px; }
      h1, h2, h3 { line-height: 1.2; }
      h1 { margin: 0 0 8px; font-size: clamp(2rem, 5vw, 3.5rem); }
      h2 { margin: 48px 0 18px; font-size: 1.55rem; }
      h3 { margin: 0; font-size: 1.05rem; }
      a { color: var(--accent); }
      .intro { margin: 0; color: var(--muted); }
      .summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 14px;
        margin-top: 32px;
      }
      .metric, .card, .table-wrap {
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--surface);
      }
      .metric { padding: 20px; }
      .metric strong { display: block; font-size: 1.8rem; }
      .metric span, .meta { color: var(--muted); font-size: .9rem; }
      .settings { margin-top: 16px; color: var(--muted); font-size: .9rem; }
      .empty { padding: 18px 20px; border-radius: 12px; background: var(--accent-soft); }
      .warning { background: var(--warning-soft); color: var(--warning); }
      .cards { display: grid; gap: 14px; }
      .card { padding: 22px; }
      .direction { margin-bottom: 12px; }
      .details { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 8px 18px; }
      .label { color: var(--muted); font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; }
      .suggested-copy { margin: 14px 0 0; padding: 14px; border-radius: 10px; background: var(--accent-soft); }
      .table-wrap { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; }
      th, td { padding: 13px 16px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
      th { color: var(--muted); font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }
      tr:last-child td { border-bottom: 0; }
      footer { margin-top: 48px; color: var(--muted); font-size: .85rem; }
    </style>
  </head>
  <body>
    <main>
      <h1>SEO Linker report</h1>
      <p class="intro">Internal linking opportunities and FAQ coverage for human review.</p>

      <section class="summary" aria-label="Analysis summary">
        <div class="metric"><strong>{{ pages | length }}</strong><span>Pages found</span></div>
        <div class="metric"><strong>{{ content_pages | length }}</strong><span>Content pages analyzed</span></div>
        <div class="metric"><strong>{{ orphan_pages | length }}</strong><span>Orphan content pages</span></div>
        <div class="metric"><strong>{{ suggestions | length }}</strong><span>Link suggestions</span></div>
      </section>
      <p class="settings">Minimum similarity: {{ "%.3f" | format(min_similarity) }} · TF-IDF preprocessing: {{ preprocessing }}</p>

      <h2>Orphan content pages</h2>
      {% if orphan_pages %}
        <div class="cards">
          {% for page in orphan_pages %}
            <article class="card warning"><a href="{{ page.url }}">{{ page.heading }}</a></article>
          {% endfor %}
        </div>
      {% else %}
        <p class="empty">No orphan content pages found.</p>
      {% endif %}

      <h2>Link suggestions</h2>
      {% if suggestions %}
        <div class="cards">
          {% for suggestion in suggestions %}
            <article class="card">
              <h3 class="direction">{{ suggestion.source.heading }} → {{ suggestion.target.heading }}</h3>
              <div class="details">
                <div><div class="label">Source</div><a href="{{ suggestion.source.url }}">Open source page</a></div>
                <div><div class="label">Target</div><a href="{{ suggestion.target.url }}">Open target page</a></div>
                <div><div class="label">Similarity</div>{{ "%.3f" | format(suggestion.similarity) }}</div>
                <div><div class="label">Placement</div>{{ suggestion.placement_type | replace("_", " ") }}</div>
              </div>
              {% if suggestion.placement_type == "contextual" %}
                <p class="suggested-copy"><strong>Anchor:</strong> {{ suggestion.anchor_text }}<br><strong>Placement sentence:</strong> {{ suggestion.context_sentence }}</p>
              {% else %}
                <p class="suggested-copy"><strong>{{ suggestion.read_more_label }}:</strong> <a href="{{ suggestion.target.url }}">{{ suggestion.anchor_text }}</a></p>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      {% else %}
        <p class="empty">No new link suggestions found at the current threshold.</p>
      {% endif %}

      <h2>FAQ coverage</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Page</th><th>FAQ status</th></tr></thead>
          <tbody>
            {% for page in content_pages %}
              <tr><td><a href="{{ page.url }}">{{ page.heading }}</a></td><td>{{ faq_status_label(page.faq_status) }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <h2>All pages</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Page</th><th>Words</th><th>Outgoing targets</th><th>Pages linking here</th><th>Analyzed</th></tr></thead>
          <tbody>
            {% for page in pages %}
              <tr>
                <td><a href="{{ page.url }}">{{ page.heading }}</a><div class="meta">{{ page.title }}</div></td>
                <td>{{ page.word_count }}</td>
                <td>{{ page.internal_links | length }}</td>
                <td>{{ incoming_sources[page.url] | length }}</td>
                <td>{{ "Yes" if page.analyze_content else "No" }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <footer>Generated {{ generated_at.strftime("%Y-%m-%d %H:%M UTC") }}. Review all suggestions before editing your website.</footer>
    </main>
  </body>
</html>
